From 630066c0826d17dc7b1805ca6d679e57183744cb Mon Sep 17 00:00:00 2001
From: David Anderson <dvander@google.com>
Date: Fri, 11 Oct 2024 12:00:00 -0700
Subject: [PATCH] sepolicy: Restore attribute ordering

Keep adbd_common before sdcard_posix_contextmount_type, matching
LineageOS 24.0.

Change-Id: I684ed7b6796997ee88ffc6777e0c76a71b73ce76
---
 private/attributes | 5 ++---
 1 file changed, 2 insertions(+), 3 deletions(-)

diff --git a/private/attributes b/private/attributes
index 8bf5d62..e8e004c 100644
--- a/private/attributes
+++ b/private/attributes
@@ -15,13 +15,12 @@ expandattribute system_and_vendor_property_type false;
 attribute sdk_sandbox_all;
 # The SDK sandbox domains for the current SDK level.
 attribute sdk_sandbox_current;
+# Common to adbd and adbd_tradeinmode.
+attribute adbd_common;
 
 # All types used for sdcard_posix context= mounts.
 attribute sdcard_posix_contextmount_type;
 
-# Common to adbd and adbd_tradeinmode.
-attribute adbd_common;
-
 # Provides access to platform update services.
 # WARNING: USING THE update_provider ATTRIBUTE WILL CAUSE CTS TO FAIL!
 attribute update_provider;
