+                        break;
+                    case FEATURE_ANTI_FLICKER:
+                        IAntiFlicker.Stub.asInterface(b).setEnabled(enable);
+                        break;
+                    case FEATURE_AUTO_CONTRAST:
+                        IAutoContrast.Stub.asInterface(b).setEnabled(enable);
