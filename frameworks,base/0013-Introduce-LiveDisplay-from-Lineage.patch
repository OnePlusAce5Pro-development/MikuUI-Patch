+        try {
+            if (isSupportedAIDL(FEATURE_DISPLAY_MODES)) {
+                IDisplayModes displayModes =
+                        IDisplayModes.Stub.asInterface(mAIDLMap.get(FEATURE_DISPLAY_MODES));
+                modes = AIDLHelper.fromAIDLModes(displayModes.getDisplayModes());
