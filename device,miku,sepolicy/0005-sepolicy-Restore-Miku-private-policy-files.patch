 # OTA packages
-/data/miku_updates(/.*)?           u:object_r:ota_package_file:s0
+/data/lineageos_updates(/.*)?           u:object_r:ota_package_file:s0
 
 # Postinstall
 /system/bin/backuptool_ab\.functions              u:object_r:postinstall_exec:s0
@@ -18,3 +18,6 @@
 
 # Bash
 /(system_ext|system/system_ext)/bin/bash          u:object_r:shell_exec:s0
+
+# Miku-specific (restored)
+/data/miku_updates(/.*)?           u:object_r:ota_package_file:s0
