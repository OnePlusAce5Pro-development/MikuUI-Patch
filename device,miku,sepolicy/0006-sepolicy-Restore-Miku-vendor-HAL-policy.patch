+get_prop(system_app, vendor_fm_radio_app_prop)
diff --git a/common/vendor/system_server.te b/common/vendor/system_server.te
new file mode 100644
index 0000000..8b853c7
--- /dev/null
+++ b/common/vendor/system_server.te
@@ -0,0 +1,2 @@
+# Trust
+get_prop(system_server, vendor_security_patch_level_prop)
diff --git a/common/vendor/vdc.te b/common/vendor/vdc.te
new file mode 100644
index 0000000..9123f99
--- /dev/null
+++ b/common/vendor/vdc.te
@@ -0,0 +1 @@
+dontaudit vdc self:capability kill;
diff --git a/common/vendor/vendor_init.te b/common/vendor/vendor_init.te
new file mode 100644
index 0000000..aa0f183
--- /dev/null
+++ b/common/vendor/vendor_init.te
@@ -0,0 +1,14 @@
+# FM Radio app properties
+set_prop(vendor_init, vendor_fm_radio_app_prop)
+
+# NFC
+set_prop(vendor_init, vendor_persist_nfc_prop)
+
+# To write to VM nodes
+allow vendor_init proc_dirty:file w_file_perms;
+
+# Camera IDs remapping
+set_prop(vendor_init, vendor_camera_remapid_prop)
+
+# Camera skip failed IDs
+set_prop(vendor_init, vendor_camera_skip_failed_ids_prop)
