From 86246624223854e4f168d70cc7190f43b3cd6330 Mon Sep 17 00:00:00 2001
From: Bruno Martins <bgcngm@gmail.com>
Date: Sat, 3 Oct 2026 12:00:00 +0000
Subject: [PATCH] sepolicy: Restore Miku vendor HAL policy

Restore vendor file contexts and rules for camera, touch, health,
LiveDisplay, PowerShare, IR, NFC, radio and USB HALs.

Change-Id: I02a3fee949411f6a43ef3736c975823fbc7188df
---
 common/vendor/device.te                       |  1 +
 common/vendor/file_contexts                   | 38 +++++++++++++++----
 common/vendor/flags_health_check.te           |  2 +
 common/vendor/fsck.te                         |  1 +
 common/vendor/hal_camera_default.te           |  2 +
 common/vendor/hal_ir_default.te               |  3 ++
 common/vendor/hal_lineage_health_default.te   |  7 ++++
 .../vendor/hal_lineage_livedisplay_sysfs.te   | 10 +++++
 .../vendor/hal_lineage_powershare_default.te  |  7 ++++
 common/vendor/hal_lineage_touch_default.te    |  2 +
 common/vendor/hal_nfc_default.te              |  1 +
 common/vendor/hal_radio_config_default.te     |  1 +
 common/vendor/hal_radio_default.te            |  1 +
 common/vendor/hal_usb_default.te              |  7 ++++
 common/vendor/hwservice.te                    |  3 ++
 common/vendor/hwservice_contexts              |  3 ++
 common/vendor/init.te                         |  7 ++++
 common/vendor/rild.te                         |  2 +
 common/vendor/secure_element.te               |  2 +
 common/vendor/system_app.te                   |  2 +
 common/vendor/system_server.te                |  2 +
 common/vendor/vdc.te                          |  1 +
 common/vendor/vendor_init.te                  | 14 +++++++
 23 files changed, 112 insertions(+), 7 deletions(-)
 create mode 100644 common/vendor/device.te
 create mode 100644 common/vendor/flags_health_check.te
 create mode 100644 common/vendor/fsck.te
 create mode 100644 common/vendor/hal_ir_default.te
 create mode 100644 common/vendor/hal_lineage_health_default.te
 create mode 100644 common/vendor/hal_lineage_livedisplay_sysfs.te
 create mode 100644 common/vendor/hal_lineage_powershare_default.te
 create mode 100644 common/vendor/hal_nfc_default.te
 create mode 100644 common/vendor/hal_radio_config_default.te
 create mode 100644 common/vendor/hal_radio_default.te
 create mode 100644 common/vendor/hal_usb_default.te
 create mode 100644 common/vendor/hwservice.te
 create mode 100644 common/vendor/hwservice_contexts
 create mode 100644 common/vendor/init.te
 create mode 100644 common/vendor/rild.te
 create mode 100644 common/vendor/secure_element.te
 create mode 100644 common/vendor/system_app.te
 create mode 100644 common/vendor/system_server.te
 create mode 100644 common/vendor/vdc.te
