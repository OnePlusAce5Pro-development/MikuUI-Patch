-hal_attribute_lineage(lineage_touch)
diff --git a/common/public/file.te b/common/public/file.te
new file mode 100644
index 0000000..00c194d
--- /dev/null
+++ b/common/public/file.te
@@ -0,0 +1,2 @@
+type iso9660, sdcard_type, fs_type, mlstrustedobject;
+type udf, sdcard_type, fs_type, mlstrustedobject;
diff --git a/common/public/property.te b/common/public/property.te
index ef4e1de..b876354 100644
--- a/common/public/property.te
+++ b/common/public/property.te
@@ -1,2 +1,8 @@
+# NFC
+system_public_prop(vendor_persist_nfc_prop)
+
+# USB
+system_vendor_config_prop(usb_uvc_config_prop)
+
 # xtra-daemon control
 system_restricted_prop(xtra_control_prop)
